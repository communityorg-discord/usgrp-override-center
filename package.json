{
  "name": "usgrp-override-center",
  "version": "2.4.14",
  "description": "USGRP Override Center - Superuser Desktop App",
  "main": "src/main/main.js",
  "author": {
    "name": "USGRP",
    "email": "admin@usgrp.xyz"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "xyz.usgrp.override",
    "productName": "USGRP Override Center",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist-renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "USGRP.Override.Center.Setup.${version}.${ext}"
    },
    "compression": "normal",
    "publish": {
      "provider": "github",
      "owner": "communityorg-discord",
      "repo": "usgrp-override-center"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "fast-glob": "^3.3.3",
    "node-pty": "^1.1.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.7.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  }
}
